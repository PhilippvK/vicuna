# Synthesis Makefile for demo
# requires GNU make; avoid spaces in directory names!

# get the absolute path of the simulation directory (must not contain spaces!)
DEMO_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

# tcl script
GEN_DEMO_TCL := gen_demo_vicuna2.tcl
GET_PERF_TCL := get_max_clk.tcl

# select the core to use as main processor (defaults to Ibex)
CORE     ?= ibex
# CORE_DIR := $(DEMO_DIR)/../$(CORE)/
CORE_DIR := /work/git/vicuna2/vicuna2_tinyml_benchmarking/rtl/cv32e40x

# VPROC_DIR := $(DEMO_DIR)/../
VPROC_DIR := /work/git/vicuna2/vicuna2_tinyml_benchmarking/rtl/vproc_rtl

FPU_SS_DIR := /work/git/vicuna2/vicuna2_tinyml_benchmarking/rtl/fpu_ss/
# FPNEW_DIR := /work/git/vicuna2/vicuna2_tinyml_benchmarking/rtl/fpu_ss/fpnew
FPNEW_DIR := $(FPU_SS_DIR)/fpnew

ifeq ($(CORE), ibex)
  CLK_START ?= 80
  CLK_STEP  ?= 16
else
ifeq ($(BOARD), cv32e40x)
  CLK_START ?= 40
  CLK_STEP  ?= 16
endif
endif

# board and associated part, constraints file and clock info
BOARD  ?= nexysvideo
CONSTR ?= $(BOARD).xdc
ifeq ($(BOARD), nexysvideo)
  PART     ?= xc7a200tsbg484-1
  DIFF_CLK ?= 0
  CLK_PER  ?= 10.0
else
ifeq ($(BOARD), genesys2)
  PART     ?= xc7k325tffg900-2
  DIFF_CLK ?= 1
  CLK_PER  ?= 5.0
else
ifeq ($(BOARD), xc7vx690tffg1157)
  PART     ?= xc7vx690tffg1157-3
  DIFF_CLK ?= 0
  CLK_PER  ?= 20.0
else
ifeq ($(BOARD), nexysa7)
  PART     ?= xc7a100tcsg324-1
  DIFF_CLK ?= 0
  CLK_PER  ?= 10.0
endif
endif
endif
endif

# project target directory
TMP_DIR  := $(shell mktemp -d)
PROJ_DIR ?= $(TMP_DIR)
RAM_FILE ?= demo.vmem

all: proj

# vector coprocessor configuration file generation (defines VMEM_W and VREG_W)
VPROC_CONFIG_PKG := $(PROJ_DIR)/vproc_config.sv
VMEM_W			 := 32

# default
# VREG_W       := 128
# VPROC_CONFIG := compact
# VPORT_POLICY := few
# SV_DEFINES := "RISCV_ZVE32X"

# VPROC_CONFIG := legacy

# small
# VREG_W       := 128
# VPROC_CONFIG := dual
# VPORT_POLICY := few
# VLANE_W := 32
# SV_DEFINES := "RISCV_ZVE32X"

# small_new
# VREG_W       := 128
# VPROC_CONFIG := dual-zve32x
# VPORT_POLICY := few
# VLANE_W := 32
# SV_DEFINES := "RISCV_ZVE32X"

# small_new_fpu
VREG_W       := 128
VPROC_CONFIG := dual-zve32f
VPORT_POLICY := few
VLANE_W := 32
# SV_DEFINES := "RISCV_ZVE32X RISCV_F RISCV_ZVE32F"
SV_DEFINES := "RISCV_ZVE32X RISCV_F RISCV_ZVE32F RISCV_ZFH RISCV_ZVFH"

# medium
# VREG_W       := 512
# VPROC_CONFIG := dual
# VPORT_POLICY := few
# VLANE_W := 256
# SV_DEFINES := "RISCV_ZVE32X"

# medium_new
# VREG_W       := 512
# VPROC_CONFIG := dual-zve32x
# VPORT_POLICY := few
# VLANE_W := 256
# SV_DEFINES := "RISCV_ZVE32X"

# fast
# VREG_W       := 2048
# VPROC_CONFIG := dual
# VPORT_POLICY := some
# VLANE_W := 1024
# SV_DEFINES := "RISCV_ZVE32X"


# include $(DEMO_DIR)/../config.mk
include $(VPROC_DIR)/config.mk

proj: $(VPROC_CONFIG_PKG)
	cd $(PROJ_DIR) && vivado -mode batch -source $(abspath $(GEN_DEMO_TCL))   \
	    -tclargs $(abspath $(DEMO_DIR))/rtl_vicuna2 $(abspath $(VPROC_DIR)) $(abspath $(CORE_DIR)) $(abspath $(FPNEW_DIR)) $(abspath $(FPU_SS_DIR)) $(VPROC_CONFIG_PKG)   \
	    $(PART) $(abspath $(CONSTR)) $(abspath $(RAM_FILE))                   \
	    $(DIFF_CLK) $(CLK_PER) $(SV_DEFINES);                                               \
	echo "";                                                                  \
	echo 'Open the project with: $$ vivado $(PROJ_DIR)/vicuna_demo/*.xpr'

perf: proj
	cd $(PROJ_DIR) && vivado -mode batch -source $(abspath $(GET_PERF_TCL))   \
	    -tclargs vicuna_demo/vicuna_demo.xpr $(CLK_START) $(CLK_STEP) sysclk
